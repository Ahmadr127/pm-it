# ============================================================
# Konfigurasi aplikasi — salin menjadi .env lalu sesuaikan.
# JANGAN commit file .env ke repository.
# PENTING: bungkus nilai dengan tanda kutip bila mengandung karakter #, spasi, atau tanda kutip,
#          contoh: DB_PASSWORD="P@ss#2026" — tanpa kutip, teks setelah # dianggap komentar.
# ============================================================
NODE_ENV=production
PORT=3000
APP_NAME=PM-IT Asset Monitoring
COMPANY_NAME=RS Azra
TZ=Asia/Jakarta
# URL publik aplikasi (dipakai untuk tautan di laporan)
APP_URL=http://localhost:3000

# --- Database (MySQL 8 / MariaDB 10.4+) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=pm_asset
DB_USER=pm_app
DB_PASSWORD="ganti_dengan_password_kuat"
DB_CONNECTION_LIMIT=10

# --- Keamanan ---
# Isi dengan string acak minimal 32 karakter, mis. hasil:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=
# true bila aplikasi diakses lewat HTTPS (wajib di produksi yang memakai HTTPS)
COOKIE_SECURE=false
# Lama sesi tanpa aktivitas (menit)
SESSION_IDLE_MINUTES=60
# Set 1 bila aplikasi berada di belakang reverse proxy (Nginx/IIS)
TRUST_PROXY=0
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# Password awal akun "admin" saat seed pertama. Kosongkan untuk dibuatkan acak (ditampilkan sekali di terminal).
ADMIN_INITIAL_PASSWORD=

# --- Unggahan file ---
# Folder penyimpanan di LUAR folder public. Relatif terhadap root aplikasi atau path absolut.
UPLOAD_DIR=storage/uploads
MAX_IMAGE_MB=5
MAX_PDF_MB=10

# --- Backup ---
BACKUP_DIR=storage/backups
# Path mysqldump / mysql bila tidak ada di PATH (contoh XAMPP Windows: C:\xampp\mysql\bin\mysqldump.exe)
MYSQLDUMP_PATH=mysqldump
MYSQL_PATH=mysql
BACKUP_RETENTION_DAYS=30

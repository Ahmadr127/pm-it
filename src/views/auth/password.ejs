<%- include('../partials/top') %>
<div class="row justify-content-center">
  <div class="col-lg-6 col-xl-5">
    <% if (forced) { %>
      <div class="alert alert-warning"><i class="bi bi-shield-exclamation me-1"></i>Demi keamanan, Anda wajib mengganti password awal sebelum menggunakan aplikasi.</div>
    <% } %>
    <div class="card">
      <div class="card-header"><i class="bi bi-key me-2"></i>Ganti Password</div>
      <div class="card-body">
        <form method="post" action="/password" data-ajax novalidate>
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div class="alert alert-danger d-none" data-form-alert></div>
          <div class="mb-3"><label class="form-label">Password saat ini<span class="req">*</span></label><input type="password" class="form-control" name="current_password" autocomplete="current-password" required></div>
          <div class="mb-3"><label class="form-label">Password baru<span class="req">*</span></label><input type="password" class="form-control" name="new_password" autocomplete="new-password" required>
            <div class="form-text"><%= pwHint %></div></div>
          <div class="mb-4"><label class="form-label">Ulangi password baru<span class="req">*</span></label><input type="password" class="form-control" name="confirm_password" autocomplete="new-password" required></div>
          <button class="btn btn-primary" type="submit"><i class="bi bi-check2 me-1"></i>Simpan Password</button>
        </form>
      </div>
    </div>
  </div>
</div>
<%- include('../partials/bottom') %>

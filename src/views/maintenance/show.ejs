<%- include('../partials/top') %>
<% const ev = r.evaluation || { items: [], flags: [], recommendations: [], not_checked: [] }; %>
<div class="d-flex flex-wrap gap-2 align-items-center justify-content-between mb-3">
  <div>
    <div class="d-flex flex-wrap gap-2 align-items-center"><span class="mono fw-bold fs-5"><%= r.maintenance_no %></span><%- h.recordBadge(r.status) %><%- h.statusBadge(r.evaluated_status) %><% if (r.priority) { %><%- h.priorityBadge(r.priority) %><% } %><%- h.approvalBadge(r.approval_status) %></div>
    <div class="small text-muted mt-1"><%= h.fmtDate(r.maintenance_date, true) %> <%= r.check_time ? `· ${r.check_time.slice(0,5)}` : '' %> · Petugas: <%= r.technician_name || '-' %> · Sumber data: <%= { MANUAL: 'manual', AGENT: 'agent', CAMPURAN: 'manual + agent' }[r.data_source] %></div>
  </div>
  <div class="d-flex gap-2 flex-wrap">
    <a href="/maintenance/<%= r.id %>/print" target="_blank" class="btn btn-light"><i class="bi bi-printer me-1"></i>Cetak PDF</a>
    <% if (canEditRec) { %><a href="/maintenance/<%= r.id %>/edit" class="btn btn-primary"><i class="bi bi-pencil me-1"></i>Ubah</a><% } %>
    <% if (can('maintenance.delete')) { %><form method="post" action="/maintenance/<%= r.id %>/delete" data-ajax data-confirm="Hapus maintenance <%= r.maintenance_no %>? Data disembunyikan (soft delete) dan tercatat di audit log." data-confirm-ok="Ya, hapus"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-outline-danger"><i class="bi bi-trash"></i></button></form><% } %>
  </div>
</div>

<% if (r.approval_status === 'Menunggu' && can('maintenance.approve')) { %>
<div class="card mb-3 border-warning"><div class="card-body">
  <div class="fw-bold mb-2"><i class="bi bi-patch-question me-1"></i>Tinjauan Manager IT</div>
  <form method="post" action="/maintenance/<%= r.id %>/approve" data-ajax class="row g-2 align-items-end" novalidate><input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="alert alert-danger d-none col-12" data-form-alert></div>
    <div class="col-md-7"><label class="form-label">Catatan peninjauan</label><input class="form-control" name="approval_notes" maxlength="500" placeholder="Wajib diisi bila ditolak"></div>
    <div class="col-md-5 d-flex gap-2"><button class="btn btn-success" name="decision" value="Disetujui" data-decision="Disetujui"><i class="bi bi-check2 me-1"></i>Setujui</button><button class="btn btn-outline-danger" name="decision" value="Ditolak" data-decision="Ditolak"><i class="bi bi-x-lg me-1"></i>Tolak & kembalikan</button></div>
    <input type="hidden" name="decision" value="" data-decision-input>
  </form>
</div></div>
<% } else if (r.approval_status === 'Disetujui' || r.approval_status === 'Ditolak') { %>
<div class="alert <%= r.approval_status === 'Disetujui' ? 'alert-success' : 'alert-warning' %>"><i class="bi bi-patch-check me-1"></i><%= r.approval_status %> oleh <strong><%= r.approver_name %></strong> pada <%= h.fmtDateTime(r.approved_at) %><%= r.approval_notes ? ` — "${r.approval_notes}"` : '' %></div>
<% } %>

<div class="row g-3">
  <div class="col-xl-8">
    <div class="card mb-3"><div class="card-header">Identitas aset & pengguna <span class="text-muted fw-normal small">(snapshot saat pemeriksaan)</span></div><div class="card-body">
      <div class="row g-3"><div class="col-md-6"><dl class="kv">
        <dt>Kode aset</dt><dd><a href="/assets/<%= r.asset_id %>" class="code-chip"><%= r.asset_code_snapshot %></a></dd><dt>Nama perangkat</dt><dd><%= r.hostname_snapshot %></dd>
        <dt>Jenis</dt><dd><%= r.device_type_snapshot %></dd><dt>Brand / model</dt><dd><%= r.brand_model_snapshot || '-' %></dd>
      </dl></div><div class="col-md-6"><dl class="kv">
        <dt>Pengguna</dt><dd><%= r.employee_name_snapshot || '-' %> <span class="text-muted fw-normal"><%= r.employee_nik_snapshot || '' %></span></dd><dt>Departemen</dt><dd><%= r.department_snapshot || '-' %></dd>
        <dt>Unit kerja</dt><dd><%= r.work_unit_snapshot || '-' %></dd><dt>Lokasi</dt><dd><%= [r.location_snapshot, r.room_snapshot].filter(Boolean).join(' · R. ') || '-' %></dd>
      </dl></div></div>
    </div></div>

    <div class="row g-3 mb-3">
      <div class="col-md-6"><div class="soft-card soft-ssd">
        <div class="soft-title"><span class="ico"><i class="bi bi-device-ssd"></i></span>CPU & SSD</div>
        <dl class="kv mb-3"><dt>Suhu CPU</dt><dd><%= r.cpu_temp_c !== null ? `${h.fmtNum(r.cpu_temp_c)} °C` : 'Tidak dapat dibaca / tidak diperiksa' %></dd><dt>Kondisi beban</dt><dd><%= r.cpu_load_condition || '-' %></dd><dt>Alat ukur / sumber</dt><dd><%= r.cpu_reading_tool || '-' %> · <%= r.cpu_data_source %></dd></dl>
        <% const ssd = r.storages.filter(s => s.storage_type === 'SSD'); if (r.ssd_presence === 'TIDAK_ADA') { %><div class="text-muted"><i class="bi bi-slash-circle me-1"></i>Tidak Ada SSD (tidak berlaku)</div><% } else if (!ssd.length) { %><div class="text-muted small">Tidak ada data SSD.</div><% } %>
        <% for (const s of ssd) { %><div class="storage-item"><div class="storage-head"><span>SSD <%= s.interface || '' %> · <%= [s.brand, s.model].filter(Boolean).join(' ') || '-' %></span><%- h.statusBadge(s.evaluated_level || (r.status === 'Draft' ? 'BELUM_DIEVALUASI' : 'TIDAK_TERSEDIA')) %></div>
          <div class="row small g-1"><div class="col-6">Suhu: <strong><%= h.show(s.temperature_c, ' °C') %></strong></div><div class="col-6">Health: <strong><%= h.show(s.health_percent, '%') %></strong></div><div class="col-6">Kapasitas: <%= h.fmtCapacity(s.capacity_gb) %></div><div class="col-6">Terpakai: <%= h.show(s.used_percent, '%', '-') %></div><div class="col-6">SMART: <strong><%= s.smart_status || 'Belum diperiksa' %></strong></div><div class="col-6">SN: <span class="mono"><%= s.serial_number || '-' %></span></div></div></div><% } %>
      </div></div>
      <div class="col-md-6"><div class="soft-card soft-hdd">
        <div class="soft-title"><span class="ico"><i class="bi bi-device-hdd"></i></span>HDD</div>
        <% const hdd = r.storages.filter(s => s.storage_type === 'HDD'); %>
        <% if (r.hdd_presence === 'TIDAK_ADA') { %><div class="text-muted"><i class="bi bi-slash-circle me-1"></i>Tidak Ada HDD (tidak berlaku)</div><% } else if (!hdd.length) { %><div class="text-muted small">Tidak ada data HDD.</div><% } %>
        <% for (const s of hdd) { %><div class="storage-item"><div class="storage-head"><span>HDD <%= s.interface || '' %> · <%= [s.brand, s.model].filter(Boolean).join(' ') || '-' %></span><%- h.statusBadge(s.evaluated_level || (r.status === 'Draft' ? 'BELUM_DIEVALUASI' : 'TIDAK_TERSEDIA')) %></div>
          <div class="row small g-1"><div class="col-6">Suhu: <strong><%= h.show(s.temperature_c, ' °C') %></strong></div><div class="col-6">Health: <strong><%= h.show(s.health_percent, '%') %></strong></div><div class="col-6">Kapasitas: <%= h.fmtCapacity(s.capacity_gb) %></div><div class="col-6">Terpakai: <%= h.show(s.used_percent, '%', '-') %></div><div class="col-6">SMART: <strong><%= s.smart_status || 'Belum diperiksa' %></strong></div><div class="col-6">SN: <span class="mono"><%= s.serial_number || '-' %></span></div></div></div><% } %>
      </div></div>
      <div class="col-md-6"><div class="soft-card soft-bat">
        <div class="soft-title"><span class="ico"><i class="bi bi-battery-half"></i></span>Baterai</div>
        <% if (!r.battery || !r.battery.is_applicable) { %><div class="text-muted"><i class="bi bi-plug me-1"></i>Tidak Berlaku</div><% } else { const b = r.battery; %>
        <dl class="kv"><dt>Battery health</dt><dd><%= h.show(b.health_percent, '%') %></dd><dt>Design / full charge</dt><dd><%= h.show(b.design_capacity_mwh, ' mWh', '-') %> / <%= h.show(b.full_charge_capacity_mwh, ' mWh', '-') %></dd>
          <dt>Cycle count</dt><dd><%= h.show(b.cycle_count, '', '-') %></dd><dt>Status</dt><dd><%= b.battery_status || '-' %></dd><dt>Catatan</dt><dd class="fw-normal"><%= b.notes || '-' %></dd></dl><% } %>
      </div></div>
      <div class="col-md-6"><div class="soft-card soft-phy">
        <div class="soft-title"><span class="ico"><i class="bi bi-wind"></i></span>Perawatan Fisik</div>
        <% for (const t of r.tasks) { %><div class="d-flex justify-content-between small py-1 border-bottom"><span><%= t.task_name %><% if (t.notes) { %><span class="text-muted"> — <%= t.notes %></span><% } %></span>
          <span><%- t.status === 'Sudah dilakukan' ? h.pill('Sudah', 'success') : t.status === 'Tidak diperlukan' ? h.pill('Tidak perlu', 'secondary') : t.status === 'Belum dilakukan' ? h.pill('Belum', 'danger') : h.pill('Belum dikonfirmasi', 'light') %></span></div><% } %>
        <div class="small mt-2">Kondisi fisik: <strong><%= r.physical_condition || '-' %></strong></div>
      </div></div>
    </div>

    <div class="card mb-3"><div class="card-header">Catatan preventive maintenance</div><div class="card-body">
      <div class="row g-3">
        <div class="col-12"><div style="white-space:pre-line"><%= r.findings || '-' %></div></div>
        <% for (const [k, l] of [['user_complaint','Keluhan pengguna'],['root_cause','Analisis penyebab'],['actions_taken','Tindakan yang dilakukan'],['recommendation','Rekomendasi IT'],['spare_parts_needed','Kebutuhan spare part']]) { if (!r[k]) continue; %>
          <div class="col-md-6"><div class="small text-muted fw-semibold"><%= l %></div><div style="white-space:pre-line"><%= r[k] %></div></div>
        <% } %>
      </div>
    </div></div>

    <div class="card"><div class="card-header">Dokumentasi</div><div class="card-body">
      <% if (!r.attachments.length) { %><div class="text-muted small">Tidak ada lampiran.</div><% } %>
      <div class="row g-3"><% for (const f of r.attachments) { %><div class="col-6 col-md-4 col-xl-3"><div class="file-tile">
        <% if (f.mime_type.startsWith('image/')) { %><a href="/files/<%= f.id %>" target="_blank" rel="noopener"><img class="thumb" src="/files/<%= f.id %>" alt="<%= f.original_name %>" loading="lazy"></a><% } else { %><a href="/files/<%= f.id %>" target="_blank" rel="noopener" class="thumb d-grid text-danger" style="place-items:center"><i class="bi bi-file-earmark-pdf fs-1"></i></a><% } %>
        <div class="small fw-semibold text-truncate mt-1" title="<%= f.original_name %>"><%= f.original_name %></div>
        <div class="small text-muted"><%= ({ DOKUMENTASI:'Dokumentasi', FOTO_SEBELUM:'Foto sebelum', FOTO_SESUDAH:'Foto sesudah', SCREENSHOT_STORAGE:'Screenshot storage', DOKUMEN_PDF:'Dokumen PDF', BUKTI_SPAREPART:'Bukti spare part' })[f.category] %> · <%= h.fmtBytes(f.size_bytes) %></div>
      </div></div><% } %></div>
    </div></div>
  </div>

  <div class="col-xl-4">
    <div class="card mb-3"><div class="card-header">Evaluasi kondisi hardware</div><div class="card-body">
      <div class="d-flex justify-content-between align-items-center mb-2"><span class="small text-muted">Hasil sistem</span><%- h.statusBadge(r.evaluated_status) %></div>
      <div class="d-flex justify-content-between align-items-center mb-3"><span class="small text-muted">Kondisi akhir (teknisi)</span><%- h.finalBadge(r.final_condition) %></div>
      <% if (r.status === 'Draft') { %><div class="text-muted small">Evaluasi dijalankan saat maintenance disimpan (bukan Draft).</div><% } else { %>
        <% for (const i of ev.items.filter(x => x.level !== 'TIDAK_BERLAKU')) { %><div class="eval-item"><div><%- h.statusBadge(i.level) %></div><div class="small"><%= i.scope ? `${i.scope}: ` : '' %><%= i.message %></div></div><% } %>
        <% if (ev.flags.length) { %><div class="alert alert-warning small mt-3 mb-0"><% for (const f of ev.flags) { %><div><i class="bi bi-exclamation-triangle me-1"></i><%= f.message %></div><% } %></div><% } %>
        <% if (ev.recommendations.length) { %><div class="mt-3"><div class="small fw-semibold mb-1">Rekomendasi tindakan</div><ul class="small mb-0 ps-3"><% for (const x of ev.recommendations) { %><li><%= x %></li><% } %></ul></div><% } %>
      <% } %>
    </div></div>
    <div class="card mb-3"><div class="card-header">Tindak lanjut</div><div class="card-body">
      <dl class="kv"><dt>Status</dt><dd><%= r.follow_up_status || '-' %></dd><dt>PIC</dt><dd><%= r.follow_up_pic || '-' %></dd><dt>Target</dt><dd><%= h.fmtDate(r.follow_up_target_date) %></dd><dt>Maintenance berikutnya</dt><dd><%= h.fmtDate(r.next_maintenance_date) %></dd></dl>
      <% for (const f of followUps) { %><a href="/follow-ups?asset_id=<%= r.asset_id %>" class="d-block border rounded-3 p-2 mt-2 text-reset small"><div class="d-flex justify-content-between"><%- h.priorityBadge(f.priority) %><%- h.followBadge(f.status) %></div><div class="fw-semibold mt-1"><%= f.title %></div><div class="text-muted">PIC: <%= f.pic || f.pic_name || '-' %> · Target <%= h.fmtDate(f.target_date) %></div></a><% } %>
      <% if (can('followup.manage')) { %><button class="btn btn-soft btn-sm mt-3 w-100" data-modal-form="#repairModal" data-title="Catat Perbaikan / Penggantian" data-values="<%= JSON.stringify({ asset_id: r.asset_id, maintenance_record_id: r.id, repair_date: h.today() }) %>"><i class="bi bi-wrench me-1"></i>Catat perbaikan / penggantian komponen</button><% } %>
      <% for (const rp of repairs) { %><div class="small mt-2"><i class="bi bi-wrench-adjustable me-1"></i><%= h.fmtDate(rp.repair_date) %> · <%= rp.repair_type %>: <strong><%= rp.component %></strong></div><% } %>
    </div></div>
    <% if (can('sparepart.view')) { %>
    <div class="card mb-3"><div class="card-header d-flex justify-content-between align-items-center"><span><i class="bi bi-box-seam me-1"></i>Spare part dipakai</span>
      <% if (canSpare) { %><button type="button" class="btn btn-soft btn-sm" data-modal-form="#spareModal" data-title="Catat pemakaian spare part"><i class="bi bi-plus-lg me-1"></i>Catat</button><% } %></div>
      <div class="card-body" data-spare-used>
        <% if (!spareUsed.length) { %><div class="text-muted small">Belum ada spare part yang dicatat untuk maintenance ini.</div><% } %>
        <% for (const m of spareUsed) { %><div class="d-flex justify-content-between small py-1 border-bottom">
          <span><a href="/spare-parts/<%= m.spare_part_id %>" class="text-reset fw-semibold"><%= m.name %></a><% if (m.note) { %><span class="text-muted"> · <%= m.note %></span><% } %></span>
          <span class="text-nowrap fw-semibold"><%= Math.abs(m.qty) %> <%= m.unit %></span></div><% } %>
      </div></div>
    <% } %>
    <div class="card"><div class="card-body small text-muted">Dibuat oleh <%= r.creator_name || '-' %> pada <%= h.fmtDateTime(r.created_at) %><br>Diperbarui <%= h.fmtDateTime(r.updated_at) %><% if (r.completed_at) { %><br>Selesai <%= h.fmtDateTime(r.completed_at) %><% } %></div></div>
  </div>
</div>

<% if (autoPrint) { %>
<div class="modal fade" id="printModal" tabindex="-1" aria-hidden="true" data-autoshow><div class="modal-dialog modal-xl modal-dialog-centered"><div class="modal-content">
  <div class="modal-header"><h5 class="modal-title">Laporan <%= r.maintenance_no %></h5><div class="ms-auto d-flex gap-2"><a class="btn btn-sm btn-primary" href="/maintenance/<%= r.id %>/print?download=1"><i class="bi bi-download me-1"></i>Unduh PDF</a><button type="button" class="btn-close ms-2" data-bs-dismiss="modal"></button></div></div>
  <div class="modal-body p-0" style="height:78vh"><iframe src="/maintenance/<%= r.id %>/print" title="Laporan PDF" style="width:100%;height:100%;border:0"></iframe></div>
</div></div></div>
<% } %>
<% if (canSpare) { %>
<div class="modal fade" id="spareModal" tabindex="-1"><div class="modal-dialog modal-dialog-centered"><div class="modal-content">
  <form method="post" action="/spare-parts/use" data-ajax novalidate>
    <div class="modal-header"><h5 class="modal-title">Catat pemakaian spare part</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
    <div class="modal-body">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="maintenance_record_id" value="<%= r.id %>">
      <div class="alert alert-danger d-none" data-form-alert></div>
      <% if (!spareOptions.length) { %><div class="alert alert-warning small mb-0">Belum ada data spare part. Tambahkan dulu di menu <a href="/spare-parts">Stok Spare Part</a>.</div><% } else { %>
      <div class="mb-3"><label class="form-label">Spare part<span class="req">*</span></label>
        <select class="form-select" name="spare_part_id" required><option value="">— Pilih —</option><% for (const o of spareOptions) { %><option value="<%= o.id %>" <%= o.stock <= 0 ? 'disabled' : '' %>><%= o.name %> (stok <%= o.stock %> <%= o.unit %>)</option><% } %></select></div>
      <div class="row g-2">
        <div class="col-4"><label class="form-label">Jumlah<span class="req">*</span></label><input class="form-control" name="qty" type="number" min="1" value="1" required></div>
        <div class="col-8"><label class="form-label">Catatan</label><input class="form-control" name="note" maxlength="255" placeholder="opsional"></div>
      </div>
      <div class="form-text">Stok langsung berkurang dan tercatat untuk PC <%= r.asset_code_snapshot %>.</div>
      <% } %>
    </div>
    <div class="modal-footer"><button type="button" class="btn btn-light" data-bs-dismiss="modal">Batal</button><button class="btn btn-primary" type="submit" <%= spareOptions.length ? '' : 'disabled' %>><i class="bi bi-check2 me-1"></i>Simpan</button></div>
  </form>
</div></div></div>
<% } %>
<%- include('../partials/repair-modal', { techs }) %>
<%- include('../partials/bottom', { scripts: ['maintenance-show.js'] }) %>

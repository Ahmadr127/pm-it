<%- include('../partials/top') %>
<%
  const [t, lb] = p.stock <= 0 ? ['danger', 'Habis'] : p.stock <= p.min_stock ? ['warning', 'Menipis'] : ['success', 'Aman'];
  const tone = { MASUK: 'success', KELUAR: 'primary', KOREKSI: 'secondary' };
%>
<div class="card mb-3"><div class="card-body d-flex flex-wrap gap-3 align-items-center">
  <div class="d-grid rounded-4" style="width:64px;height:64px;place-items:center;background:var(--purple-100);color:var(--purple-600)"><i class="bi bi-box-seam fs-3"></i></div>
  <div class="flex-grow-1 min-w-0">
    <h2 class="h5 mb-1"><%= p.name %></h2>
    <div class="small text-muted"><%= p.category || 'Tanpa kategori' %><%= p.notes ? `. ${p.notes}` : '' %></div>
    <div class="small text-muted">Stok minimum <%= p.min_stock %> <%= p.unit %></div>
  </div>
  <div class="text-end"><div class="fs-2 fw-bold lh-1"><%= p.stock %> <span class="fs-6 text-muted fw-normal"><%= p.unit %></span></div><%- h.pill(lb, t) %></div>
  <% if (manage) { %><div class="d-flex gap-2 flex-wrap w-100 justify-content-end">
    <button type="button" class="btn btn-soft" data-modal-form="#stockModal" data-action="/spare-parts/<%= p.id %>/stock" data-title="Stok masuk: <%= p.name %>" data-values='{"movement_type":"MASUK","qty":1}'><i class="bi bi-plus-lg me-1"></i>Stok masuk</button>
    <button type="button" class="btn btn-light" data-modal-form="#stockModal" data-action="/spare-parts/<%= p.id %>/stock" data-title="Pakai: <%= p.name %>" data-values='{"movement_type":"KELUAR","qty":1}' <%= p.stock <= 0 ? 'disabled' : '' %>><i class="bi bi-dash-lg me-1"></i>Pakai</button>
    <button type="button" class="btn btn-light" data-modal-form="#stockModal" data-action="/spare-parts/<%= p.id %>/stock" data-title="Koreksi stok: <%= p.name %>" data-values='<%= JSON.stringify({ movement_type: "KOREKSI", qty: p.stock }) %>'><i class="bi bi-calculator me-1"></i>Koreksi</button>
    <button type="button" class="btn btn-light" data-modal-form="#partEditModal" data-action="/spare-parts/<%= p.id %>" data-title="Ubah: <%= p.name %>" data-values="<%= JSON.stringify({ name: p.name, category: p.category, unit: p.unit, min_stock: p.min_stock, notes: p.notes }) %>"><i class="bi bi-pencil me-1"></i>Ubah</button>
  </div><% } %>
</div></div>

<div class="card table-card"><div class="card-header"><i class="bi bi-clock-history me-1"></i>Riwayat stok</div>
  <% if (!moves.length) { %><div class="card-body text-muted small">Belum ada pergerakan stok.</div><% } else { %>
  <div class="table-responsive"><table class="table align-middle mb-0">
    <thead><tr><th>Waktu</th><th>Jenis</th><th class="text-end">Jumlah</th><th class="text-end">Sisa</th><th>Untuk PC / laporan</th><th>Catatan</th><th>Oleh</th></tr></thead>
    <tbody><% for (const m of moves) { %><tr>
      <td class="small text-nowrap"><%= h.fmtDateTime(m.created_at) %></td>
      <td><%- h.pill(TYPES[m.movement_type], tone[m.movement_type]) %></td>
      <td class="text-end fw-semibold"><%= m.movement_type === 'KELUAR' ? '−' : (m.qty >= 0 ? '+' : '−') %><%= Math.abs(m.qty) %></td>
      <td class="text-end"><%= m.stock_after %></td>
      <td class="small"><% if (m.asset_code) { %><a href="/assets/<%= m.asset_id %>" class="code-chip"><%= m.asset_code %></a><% } %><% if (m.maintenance_no) { %> <a href="/maintenance/<%= m.maintenance_record_id %>"><%= m.maintenance_no %></a><% } %><% if (!m.asset_code && !m.maintenance_no) { %>-<% } %></td>
      <td class="small"><%= m.note || '-' %></td>
      <td class="small"><%= m.user_name || '-' %></td>
    </tr><% } %></tbody></table></div>
  <% } %>
</div>
<% if (manage) { %><%- include('_modals') %><% } %>
<%- include('../partials/bottom') %>

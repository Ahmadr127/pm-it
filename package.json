{
  "name": "pm-it-asset-monitoring",
  "version": "1.0.0",
  "description": "Website Preventive Maintenance PC & IT Asset Monitoring",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "node database/migrate.js",
    "migrate:fresh": "node database/migrate.js --fresh",
    "seed": "node database/seed.js",
    "demo:load": "node database/demo.js",
    "demo:remove": "node database/demo.js --remove",
    "setup": "node database/migrate.js && node database/seed.js",
    "backup": "node scripts/backup.js",
    "restore": "node scripts/restore.js",
    "test": "node --test --test-concurrency=1 tests/*.test.js",
    "reset-admin": "node scripts/reset-admin.js"
  },
  "dependencies": {
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "bcryptjs": "^3.0.3",
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.2",
    "chart.js": "^4.5.1",
    "connect-pg-simple": "^10.0.0",
    "dotenv": "^18.0.6",
    "ejs": "^7.0.1",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "express-mysql-session": "^3.0.3",
    "express-rate-limit": "^8.7.1",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "multer": "^2.4.0",
    "mysql2": "^3.24.5",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.1",
    "tom-select": "^2.6.2"
  },
  "devDependencies": {
    "supertest": "^7.3.1"
  },
  "private": true,
  "engines": {
    "node": ">=22"
  }
}
